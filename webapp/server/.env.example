# Porta HTTP/WS do servidor.
PORT=4000

# Connection string do Postgres (Supabase). Pegue em: painel do Supabase > projeto >
# Project Settings > Database > Connection String > URI. NUNCA commite este arquivo
# preenchido — o schema (schema.sql) e aplicado automaticamente na subida do servidor.
DATABASE_URL=

# --- Polarium/Quadcode (usado apenas quando BROKER_ADAPTER=polarium) ---
#
# NAO existe variavel de ambiente para o SSID: ele nunca fica fixo em lugar nenhum. Quando
# BROKER_ADAPTER=polarium, o app fica fechado por login (tela de login no frontend, ou
# POST /api/auth/login) — o SSID so entra por ali e so vive em memoria do servidor.

# platformId exigido pela assinatura ClientSdk.create(). Os exemplos oficiais do SDK usam 82
# sem documentar o significado exato para brokers white-label — confirmar com a Polarium/Quadcode.
POLARIUM_PLATFORM_ID=82

# Qual adapter usar: "mock" (padrao, sem rede, sem login) ou "polarium" (exige login).
BROKER_ADAPTER=mock

# Origem (URL) permitida para CORS com credenciais — necessario quando o frontend roda em
# outro dominio (ex.: Vercel). Em dev local pode deixar vazio (libera qualquer origem).
CORS_ORIGIN=

# "production" ativa cookies Secure/SameSite=None (necessario para login funcionar quando
# client e server estao em dominios diferentes, como Vercel + Render).
NODE_ENV=development
