# Porta HTTP/WS do servidor.
PORT=4000

# Caminho do arquivo SQLite (criado automaticamente se nao existir).
DB_PATH=./data/app.db

# --- Polarium/Quadcode (usado apenas quando BrokerAdapter = polarium) ---
# SSID da sua sessao autenticada na Polarium. NUNCA compartilhe, nunca commite este arquivo
# preenchido. Ver README do coletor de candles (../../README.md) para como obter o SSID.
POLARIUM_SSID=

# platformId exigido pela assinatura ClientSdk.create(). Os exemplos oficiais do SDK usam 82
# sem documentar o significado exato para brokers white-label — confirmar com a Polarium/Quadcode.
POLARIUM_PLATFORM_ID=82

# Qual adapter usar: "mock" (padrao, sem rede) ou "polarium".
BROKER_ADAPTER=mock
